VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 배포 후 공개 URL (소셜 로그인 OAuth 리다이렉트용)
# Vercel 예: https://reworld.vercel.app
VITE_APP_URL=https://your-app.vercel.app

# Gemini 도트 변환용 (로컬: vite.config가 loadEnv로 읽음 / 배포: Vercel Environment Variables)
GEMINI_API_KEY=YOUR_API_KEY
# SVG 도트 변환 모델 (1개만 사용). 예: gemini-2.5-flash-lite
# Nano Banana(-image 계열)는 이미지 생성 전용이라 현재 SVG 파이프라인과 호환되지 않음
GEMINI_MODEL=gemini-3.5-flash
